{
  "id": null,
  "uid": "pulsewatch-ops",
  "title": "PulseWatch — Ops Dashboard",
  "tags": ["pulsewatch", "iot", "anomaly"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Temperature — All Sensors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "pulsewatch-opensearch" },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "alias": "$tag_sensor_id",
          "bucketAggs": [
            { "id": "2", "settings": { "interval": "30s" }, "type": "date_histogram", "field": "timestamp" }
          ],
          "metrics": [{ "id": "1", "type": "avg", "field": "temperature" }],
          "query": "",
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 2,
      "title": "Vibration — All Sensors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "pulsewatch-opensearch" },
      "targets": [
        {
          "alias": "$tag_sensor_id",
          "bucketAggs": [
            { "id": "2", "settings": { "interval": "30s" }, "type": "date_histogram", "field": "timestamp" }
          ],
          "metrics": [{ "id": "1", "type": "avg", "field": "vibration" }],
          "query": "",
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 3,
      "title": "Anomaly Count (last 30 min)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "pulsewatch-opensearch" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [
        {
          "bucketAggs": [
            { "id": "2", "settings": { "interval": "30m" }, "type": "date_histogram", "field": "timestamp" }
          ],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "is_anomaly:true",
          "timeField": "timestamp",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "pulsewatch-opensearch" }
        }
      ],
      "overrideIndex": "events-anomalies"
    },
    {
      "id": 4,
      "title": "Recent Anomalies",
      "type": "table",
      "gridPos": { "h": 10, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "pulsewatch-opensearch" },
      "options": { "showHeader": true },
      "targets": [
        {
          "bucketAggs": [],
          "metrics": [{ "id": "1", "type": "raw_data" }],
          "query": "is_anomaly:true",
          "timeField": "timestamp",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "pulsewatch-opensearch" }
        }
      ],
      "overrideIndex": "events-anomalies"
    }
  ]
}
