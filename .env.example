# ============================================================
# PulseWatch — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# ------------------------------------
# Kafka
# ------------------------------------
KAFKA_BROKER=kafka:9092
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_TOPIC_RAW=raw-events
KAFKA_TOPIC_ANOMALIES=anomaly-alerts
ZOOKEEPER_HOST=zookeeper:2181

# ------------------------------------
# OpenSearch
# ------------------------------------
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_INDEX_RAW=events-raw
OPENSEARCH_INDEX_ANOMALIES=events-anomalies
# Data retention: raw events older than this many days are deleted by ILM
RETENTION_DAYS=7

# ------------------------------------
# Spark
# ------------------------------------
SPARK_MASTER=local[2]
SPARK_EXECUTOR_MEMORY=1g
SPARK_DRIVER_MEMORY=1g
# Isolation Forest retraining interval (minutes)
IF_RETRAIN_INTERVAL_MIN=5
# Sliding window: window duration and slide duration (Spark duration string)
WINDOW_DURATION=5 minutes
SLIDE_DURATION=1 minute
# Z-score threshold for spike detection
ZSCORE_THRESHOLD=3.0
# CUSUM: allowable slack before flagging cumulative drift
CUSUM_SLACK=1.0
CUSUM_THRESHOLD=5.0

# ------------------------------------
# Backend (FastAPI)
# ------------------------------------
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------
# Frontend (Next.js)
# ------------------------------------
FRONTEND_PORT=3001
# URL the browser uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------
# Grafana
# ------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
